  "narrative": {
    "northStar": "The working database, in view",
    "overview": "This descriptive name records the existing refinement direction; it is not a new visual-world selection. The website pairs a quiet dark blue canvas with actual application screenshots, readable sans typography and compact installation controls. Rounded surfaces soften a technical product without replacing its established identity.",
    "keyCharacteristics": [
      "Real application imagery provides the main visual evidence.",
      "Blue distinguishes actions, selection and useful numeric emphasis.",
      "Compact controls sit within spacious sections."
    ],
    "rules": [
      {
        "name": "The Useful Blue Rule",
        "body": "Use blue for actions, selected state and meaningful emphasis, as the page already does.",
        "section": "colors"
      },
      {
        "name": "The Reading and Commands Rule",
        "body": "Keep explanatory prose in Instrument Sans and executable commands in Martian Mono.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use real application screenshots with truthful captions.",
      "Do preserve the existing dark palette, locally hosted fonts and bilingual layouts.",
      "Do retain visible keyboard focus, selection states and reduced-motion behavior.",
      "Do use rounded controls and measured section spacing from the shipped CSS."
    ],
    "donts": [
      "Don't replace the established website identity during routine extensions.",
      "Don't add decorative filler or an oversized script demonstration.",
